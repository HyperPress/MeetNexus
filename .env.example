# MeetNexus 本机配置模板。复制后请替换占位值，禁止提交真实密码或 Token。

# API 监听地址
SERVER_ADDR=127.0.0.1:8080

# PostgreSQL 15：项目数据库名和用户均约定为 meetnexus
DATABASE_URL=postgres://meetnexus:replace-with-local-password@127.0.0.1:5432/meetnexus

# Memurai（兼容 Redis 7）：使用第 0 个逻辑数据库
REDIS_URL=redis://127.0.0.1:6379/0

# Live777 本机服务
LIVE777_URL=http://127.0.0.1:7777
# LIVE777_TOKEN=replace-with-local-token

# 房间成员会话令牌签名密钥：至少 32 个字符，生产环境请生成随机值
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Rust JSON 日志过滤级别
RUST_LOG=api=info,tower_http=info
